{
  "info": {
    "name": "Service communication timeout",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [],
  "item": [
    {
      "name": "1. 정상 호출 및 Context 전달",
      "item": [
        {
          "name": "동작 설정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{eligibility_base_url}}/api/testing/eligibility-behaviors/{{applicant_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"scenario\": \"ELIGIBLE\", \"delayMillis\": 0}"
            }
          }
        },
        {
          "name": "민원 신청",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{application_base_url}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\"applicantId\":\"{{applicant_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status',()=>pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "마지막 수신 Context 확인",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              }
            ],
            "url": "{{eligibility_base_url}}/api/testing/received-contexts/{{applicant_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('context forwarded',()=>{const body=pm.response.json();pm.expect(body.tenantId).to.eql(pm.environment.get('tenant_id'));pm.expect(body.requestId).to.eql(pm.environment.get('request_id'));pm.expect(body.traceId).to.eql(pm.environment.get('trace_id'));});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. 업무상 부적격",
      "item": [
        {
          "name": "동작 설정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{eligibility_base_url}}/api/testing/eligibility-behaviors/{{applicant_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"scenario\": \"INELIGIBLE\", \"delayMillis\": 0}"
            }
          }
        },
        {
          "name": "민원 신청",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{application_base_url}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\"applicantId\":\"{{applicant_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status',()=>pm.response.to.have.status(422));",
                  "pm.test('error code',()=>pm.expect(pm.response.json().code).to.eql('ELIGIBILITY_DENIED'));",
                  "pm.test('internal details hidden',()=>{const text=pm.response.text();['http://','ResourceAccessException','SocketTimeoutException','Envoy','stackTrace'].forEach(value=>pm.expect(text).not.to.include(value));});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. 애플리케이션 readTimeout",
      "item": [
        {
          "name": "동작 설정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{eligibility_base_url}}/api/testing/eligibility-behaviors/{{applicant_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"scenario\": \"DELAY\", \"delayMillis\": 3000}"
            }
          }
        },
        {
          "name": "민원 신청",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{application_base_url}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\"applicantId\":\"{{applicant_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status',()=>pm.response.to.have.status(503));",
                  "pm.test('error code',()=>pm.expect(pm.response.json().code).to.eql('ELIGIBILITY_SERVICE_UNAVAILABLE'));",
                  "pm.test('internal details hidden',()=>{const text=pm.response.text();['http://','ResourceAccessException','SocketTimeoutException','Envoy','stackTrace'].forEach(value=>pm.expect(text).not.to.include(value));});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. 하위 서비스 5xx 일반화",
      "item": [
        {
          "name": "동작 설정",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{eligibility_base_url}}/api/testing/eligibility-behaviors/{{applicant_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\"scenario\": \"ERROR\", \"delayMillis\": 0}"
            }
          }
        },
        {
          "name": "민원 신청",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Tenant-Id",
                "value": "{{tenant_id}}"
              },
              {
                "key": "X-Request-Id",
                "value": "{{request_id}}"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{trace_id}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{application_base_url}}/api/applications",
            "body": {
              "mode": "raw",
              "raw": "{\"applicantId\":\"{{applicant_id}}\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status',()=>pm.response.to.have.status(503));",
                  "pm.test('error code',()=>pm.expect(pm.response.json().code).to.eql('ELIGIBILITY_SERVICE_UNAVAILABLE'));",
                  "pm.test('internal details hidden',()=>{const text=pm.response.text();['http://','internal proxy detail','ResourceAccessException','SocketTimeoutException','EligibilityServiceUnavailableException','Envoy','stack trace','stackTrace'].forEach(value=>pm.expect(text).not.to.include(value));});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
